<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: GPL-3.0-or-later -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>brawl_matdump</AssemblyName>
    <OutputPath>..\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <NoWarn>CS0168;CS0219;CS0162;NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- BrawlLib (LGPL-3.0) is built from source from deps/BrawlCrate. To use your own BrawlLib, set
         -p:BrawlLibProject=path\to\BrawlLib.csproj, or replace BrawlLib.dll next to the built exe. -->
    <ProjectReference Include="$(BrawlLibProject)" Condition="'$(BrawlLibProject)' != ''" />
    <ProjectReference Include="..\..\deps\BrawlCrate\BrawlLib\BrawlLib.csproj" Condition="'$(BrawlLibProject)' == ''" />
  </ItemGroup>
</Project>
